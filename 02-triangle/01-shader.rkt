#lang racket/base
;; =========================================================
;; 02-triangle/01-shader.rkt —— 写三角形要用的两段着色器
;; 运行：racket 02-triangle/01-shader.rkt
;; =========================================================

;; 先建立对 GPU 的基本认知（这决定了着色器为什么长这样）：
;;   GPU 里有成千上万个计算单元，擅长"同一份代码、不同的数据、同时执行"。
;;   所以着色器是一个小函数：一次只处理一个顶点 / 一个像素，看不到别人，
;;   也没有全局变量可言——输入不同，输出不同，仅此而已。
;;
;; 画一个三角形需要两段着色器，各管一个阶段：
;;   顶点数据 ──▶ [顶点着色器] ──▶ 光栅化 ──▶ [片元着色器] ──▶ 屏幕
;;                每个顶点跑一次        三角形铺成像素   每个像素跑一次
;;   顶点着色器：算"这个顶点落在哪"（写 gl_Position）
;;   片元着色器：算"这个像素什么颜色"
;;
;; 着色器语言叫 GLSL。本教程不直接写 GLSL 文本，而是用 racket-glsl 的
;; (glsl ...) 宏：你写 S 表达式，它展开成真正的 GLSL，两种写法一一对应。
(require "../racket-glsl/rewrite.rkt")   ; (glsl ...) 宏 + glsl-pretty

;; ══ 顶点着色器 ══════════════════════════════════════════
;; 关键问题：GPU 每处理一个顶点，怎么拿到"当前这个顶点"的数据？
;; 答案是靠 CPU 喂。数据从 CPU 传进 GPU，用两个东西接：
;;
;;   in        —— 声明"这是本阶段的输入变量"。每个顶点执行时，GPU 自动把
;;               属于"当前顶点"的那一份数据填进这个变量。
;;   location 0 —— 给这个输入指定"槽号"0。CPU 可能同时传好几类数据（位置、
;;               颜色、法线…），GPU 靠槽号区分：location 0 = 这个 in 从 0 号槽
;;               取数据。之后 CPU 侧（VAO）也用同一个号码 0，把"位置数据"接到
;;               0 号槽——两边号码对上，数据就接通了。
;;   layout    —— GLSL 的关键字，用来写"槽号"这类额外说明（layout(...) 包起来）。
;;
;; 变量名 aPos 是我们起的：a = attribute（逐顶点输入），Pos = position。
;; 类型 vec2 = 两个 float 组成的向量（x、y）。
(define vert-src
  (glsl (version 330 core)
        (layout (location 0) in vec2 aPos)
        (define (main) void
          ;; gl_Position 是内置变量：顶点着色器必须给它赋值，它就是
          ;; "顶点最终落在哪"（-1..1 的坐标，叫 NDC）。
          ;; (vec4 aPos 0.0 1.0)：位置是 2 维的，gl_Position 要 4 维，
          ;; 所以补两个分量（齐次坐标，为什么是 4 维后面课讲）。
          (set! gl_Position (vec4 aPos 0.0 1.0)))))

;; ══ 片元着色器 ══════════════════════════════════════════
;; 顶点着色器算完位置，GPU 把三角形铺成一个个像素（光栅化），
;; 然后每个像素跑一次片元着色器，算出这个像素的颜色。
;;
;;   out       —— 声明"这是本阶段的输出"。片元着色器最重要的输出就是颜色。
;;   FragColor —— 变量名：frag = fragment（片元），color = 颜色。
;;               只有这一个输出时，名字随便起。
;;   vec4      —— 颜色 = 红 绿 蓝 不透明度，四个 0~1 的数。
(define frag-src
  (glsl (version 330 core)
        (out vec4 FragColor)
        (define (main) void
          ;; 先给所有像素一个固定橙色，看看着色器能跑起来。
          (set! FragColor (vec4 1.0 0.35 0.2 1.0)))))

;; glsl-program-src：取出 (glsl ...) 生成的美化后 GLSL 源文本，方便对照着读。
(printf "顶点着色器展开为：\n~a\n\n" (glsl-program-src vert-src))
(printf "片元着色器展开为：\n~a\n" (glsl-program-src frag-src))

;; 本步到此为止：没有窗口、没有编译、没有绘制，只是"看懂着色器文本"。
