#lang racket/base
;; =========================================================
;; 01-window/06-run-gl.rkt —— 第六步：把骨架收进一个函数
;; 运行：racket 01-window/06-run-gl.rkt
;; =========================================================
;; 前 5 步把窗口骨架（frame/canvas/上下文/清屏/翻页/视口）逐块讲透了。
;; 但你看 05-viewport.rkt 那 40 行——每课都一模一样，只有"画什么"在变。
;;
;; 所以把它们收进 lib-gui.rkt 的 run-gl：
;;   你只提供 #:draw（每帧画什么），骨架（视口、翻页、点 X 退出）由它接管。
;; 从 02 课起，所有课都用 run-gl，只写"本课核心"。
;;
;; 之后课程的通用套路（本课第一次出现，记住这个节奏）：
;;   ① 裸写一遍新机制，讲透每个函数
;;   ② 发现它每课都重复 → 收进 lib 成一个函数
;;   ③ 后面的课直接调用那个函数，聚焦本课真正的新东西
;; =========================================================

(require "../lib-gui.rkt")   ; run-gl + gl*

(run-gl
 #:title "01-06 骨架收进 run-gl" #:width 400 #:height 300
 #:draw (lambda ()
          ;; 这 2 行是 04 步学过的"画一帧"：设清屏色 → 清屏。
          ;; （run-gl 不替你清屏——每课想用什么底色自己写，保持自由）
          (glClearColor 0.10 0.12 0.20 1.0)
          (glClear GL_COLOR_BUFFER_BIT)))
